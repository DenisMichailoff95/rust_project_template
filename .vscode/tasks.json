{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: init",
      "type": "shell",
      "command": "cargo init --name ${input:projectName}",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: new (lib)",
      "type": "shell",
      "command": "cargo new --lib ${input:projectName}",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: new (bin)",
      "type": "shell",
      "command": "cargo new --bin ${input:projectName}",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: build",
      "type": "shell",
      "command": "cargo build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo: build --release",
      "type": "shell",
      "command": "cargo build --release",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo: build workspace",
      "type": "shell",
      "command": "cargo build --workspace",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo: run",
      "type": "shell",
      "command": "cargo run",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: run --release",
      "type": "shell",
      "command": "cargo run --release",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: test",
      "type": "shell",
      "command": "cargo test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: test workspace",
      "type": "shell",
      "command": "cargo test --workspace",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": false },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: test package",
      "type": "shell",
      "command": "cargo test -p ${input:packageName}",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": false },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: bench",
      "type": "shell",
      "command": "cargo bench",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: bench package",
      "type": "shell",
      "command": "cargo bench -p ${input:packageName}",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: clippy",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: fmt check",
      "type": "shell",
      "command": "cargo fmt --all --check",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: fmt",
      "type": "shell",
      "command": "cargo fmt --all",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: update dependencies",
      "type": "shell",
      "command": "cargo update",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: check",
      "type": "shell",
      "command": "cargo check",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo: check workspace",
      "type": "shell",
      "command": "cargo check --workspace",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo: doc",
      "type": "shell",
      "command": "cargo doc --no-deps",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "cargo: clean",
      "type": "shell",
      "command": "cargo clean",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "workspace: generate",
      "type": "shell",
      "command": "basename \"${workspaceFolder}\" | xargs -I {} sh -c 'cat > \"${workspaceFolder}/.vscode/rust.code-workspace\" <<EOF\n{\n    \"folders\": [\n        {\n            \"path\": \"..\",\n            \"name\": \"{}\"\n        }\n    ]\n}\nEOF'",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "template: configure",
      "type": "shell",
      "command": "PKG=$(grep '^name = ' \"${workspaceFolder}/Cargo.toml\" | head -1 | sed 's/name = \"\\(.*\\)\"/\1/') && sed -i \"s/__PACKAGE_NAME__/$PKG/g\" \"${workspaceFolder}/.vscode/launch.json\"",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": false },
      "problemMatcher": [],
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      }
    },
    {
      "label": "Build All Workspace",
      "dependsOn": [
        "cargo: build workspace",
        "cargo: clippy",
        "cargo: fmt check"
      ],
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Test All Workspace",
      "dependsOn": [
        "cargo: test workspace"
      ],
      "problemMatcher": ["$rustc"],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    }
  ],
  "inputs": [
    {
      "id": "projectName",
      "type": "promptString",
      "description": "Project name for cargo init/new",
      "default": "my_project"
    },
    {
      "id": "packageName",
      "type": "promptString",
      "description": "Package name for cargo test/bench -p",
      "default": "my_package"
    }
  ]
}