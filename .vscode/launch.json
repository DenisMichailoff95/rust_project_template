{
    "version": "0.2.0",
    "configurations": [
        {
            // Запуск основного бинарного файла проекта в режиме debug через LLDB
            "name": "Launch (debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/__PACKAGE_NAME__",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stop-on-entry": false,
            "preLaunchTask": "cargo: build"
        },
        {
            // Запуск собранного release-артефакта через LLDB
            "name": "Launch (release)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/release/__PACKAGE_NAME__",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cargo: build --release"
        },
        {
            // Запуск тестов в debug-режиме через LLDB (один поток, чтобы точнее отлаживать)
            "name": "Test (debug)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/deps/__PACKAGE_NAME__-*",
            "args": ["--test-threads=1"],
            "cwd": "${workspaceFolder}",
            "stop-on-entry": false,
            "preLaunchTask": "cargo: test"
        },
        {
            // Прикрепление LLDB к уже запущенному процессу приложения
            "name": "Attach to process",
            "type": "lldb",
            "request": "attach",
            "program": "${workspaceFolder}/target/debug/__PACKAGE_NAME__"
        }
    ]
}
